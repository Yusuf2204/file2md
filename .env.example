# ==============================================================
# File2MD - Konfigurasi Lingkungan (Environment Variables)
# Salin file ini menjadi .env lalu sesuaikan nilainya: cp .env.example .env
# ==============================================================

# Kunci rahasia untuk penandatanganan JWT Session
SECRET_KEY=ganti_dengan_kunci_acak_yang_sangat_panjang_dan_aman_2026

# Database (Default: SQLite local-first)
DATABASE_URL=sqlite:///data/file2md.db

# Base URL aplikasi (Default port 8031 untuk Docker)
APP_BASE_URL=http://localhost:8031

# --------------------------------------------------------------
# Google OAuth 2.0 (Social Login)
# Dapatkan di Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:8031/api/auth/google/callback
# --------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------------------
# GitHub OAuth (Social Login)
# Dapatkan di GitHub Settings: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: http://localhost:8031/api/auth/github/callback
# --------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

